{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Minsk",
  "schedule": [
    "before 6am on monday"
  ],
  "dependencyDashboard": false,
  "labels": ["dependencies"],
  "prConcurrentLimit": 3,
  "prHourlyLimit": 1,
  "rebaseWhen": "conflicted",
  "packageRules": [
    {
      "description": "typescript-eslint does not support TS 7 yet (typescript-eslint#10940); re-enable when it does",
      "matchPackageNames": ["typescript"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "One PR for all minor and patch updates instead of a PR per dependency — less PR and CI churn",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "minor and patch updates"
    }
  ]
}
